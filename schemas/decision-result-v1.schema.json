      "type": "integer"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/CandidateResult"
      },
      "title": "Candidates",
      "type": "array"
    },
    "dataset": {
      "$ref": "#/$defs/DatasetEvidence"
    },
    "fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fingerprint",
      "type": "string"
    },
    "identity_json": {
      "title": "Identity Json",
      "type": "string"
    },
    "optimization_direction": {
      "enum": [
        "maximize",
        "minimize"
