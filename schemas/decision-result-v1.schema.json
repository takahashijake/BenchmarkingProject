      "type": "object"
    },
    "DecisionPlan": {
      "additionalProperties": false,
      "properties": {
        "outer": {
          "items": {
            "$ref": "#/$defs/OuterPlan"
          },
          "title": "Outer",
          "type": "array"
        },
        "outer_seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Outer Seed",
          "type": "integer"
        }
      },
      "required": [
        "outer_seed",
        "outer"
      ],
      "title": "DecisionPlan",
      "type": "object"
    },
    "DecisionPrediction": {
      "additionalProperties": false,
      "properties": {
        "fold_id": {
          "minimum": 0,
          "title": "Fold Id",
          "type": "integer"
        },
        "prediction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Prediction",
          "type": "integer"
        },
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        },
        "reference_prediction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Reference Prediction",
          "type": "integer"
        },
        "sample_index": {
          "minimum": 0,
          "title": "Sample Index",
          "type": "integer"
        },
        "truth": {
          "maximum": 1,
          "minimum": 0,
          "title": "Truth",
          "type": "integer"
        }
      },
      "required": [
        "sample_index",
        "fold_id",
        "truth",
        "probability",
        "prediction",
        "reference_prediction"
      ],
