      "additionalProperties": false,
      "properties": {
        "confusion": {
          "$ref": "#/$defs/Confusion"
        },
        "objective_value": {
          "title": "Objective Value",
          "type": "number"
        },
        "threshold": {
          "maximum": 1,
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        }
      },
      "required": [
        "threshold",
        "confusion",
        "objective_value"
