      "title": "Optimization Direction",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/DecisionPlan"
    },
    "primary_metric": {
      "title": "Primary Metric",
      "type": "string"
    },
    "status": {
      "enum": [
        "success",
        "partial",
        "failed"
