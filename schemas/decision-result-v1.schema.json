{
  "$defs": {
    "Aggregate": {
      "additionalProperties": false,
      "properties": {
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "std": {
          "minimum": 0,
          "title": "Std",
          "type": "number"
        }
      },
      "required": [
        "name",
        "mean",
        "std"
      ],
      "title": "Aggregate",
      "type": "object"
    },
    "CandidateResult": {
      "additionalProperties": false,
      "properties": {
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Failure"
            },
            {
              "type": "null"
            }
          ]
        },
        "folds": {
          "items": {
            "$ref": "#/$defs/OuterEvaluation"
          },
          "title": "Folds",
          "type": "array"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Aggregate"
          },
          "title": "Metrics",
          "type": "array"
        },
        "model_name": {
          "title": "Model Name",
          "type": "string"
        },
        "parameters_json": {
          "title": "Parameters Json",
          "type": "string"
        },
        "rank": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "status": {
          "enum": [
            "success",
            "partial",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "model_name",
        "parameters_json",
        "status",
        "folds",
        "failure",
        "metrics"
      ],
      "title": "CandidateResult",
      "type": "object"
    },
    "Confusion": {
      "additionalProperties": false,
      "properties": {
        "fn": {
          "minimum": 0,
          "title": "Fn",
          "type": "integer"
        },
        "fp": {
          "minimum": 0,
          "title": "Fp",
          "type": "integer"
        },
        "tn": {
          "minimum": 0,
          "title": "Tn",
          "type": "integer"
        },
        "tp": {
          "minimum": 0,
          "title": "Tp",
          "type": "integer"
        }
      },
      "required": [
        "tn",
        "fp",
        "fn",
        "tp"
      ],
      "title": "Confusion",
      "type": "object"
    },
    "DatasetEvidence": {
      "additionalProperties": false,
      "properties": {
        "categorical_features": {
          "items": {
            "type": "string"
          },
          "title": "Categorical Features",
          "type": "array"
        },
        "content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "feature_count": {
          "exclusiveMinimum": 0,
          "title": "Feature Count",
          "type": "integer"
        },
        "identity": {
          "title": "Identity",
          "type": "string"
        },
        "numeric_features": {
          "items": {
            "type": "string"
          },
          "title": "Numeric Features",
          "type": "array"
        },
        "row_count": {
          "exclusiveMinimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "target_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Digest",
          "type": "string"
        },
        "target_labels": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Target Labels",
          "type": "array"
        },
        "target_name": {
          "title": "Target Name",
          "type": "string"
        },
        "truth": {
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "integer"
          },
          "title": "Truth",
          "type": "array"
        }
      },
      "required": [
        "identity",
        "content_digest",
        "target_digest",
        "row_count",
        "feature_count",
        "numeric_features",
        "categorical_features",
        "target_name",
        "target_labels",
        "truth"
      ],
