      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "error_type": {
          "title": "Error Type",
          "type": "string"
        },
        "fold_id": {
          "minimum": 0,
          "title": "Fold Id",
          "type": "integer"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "fold_id",
        "error_type",
        "message"
      ],
      "title": "Failure",
      "type": "object"
    },
    "FitBoundary": {
      "additionalProperties": false,
      "properties": {
        "calibration": {
          "anyOf": [
            {
              "$ref": "#/$defs/SplitPlan"
            },
            {
              "type": "null"
            }
          ]
