      "type": "object"
    },
    "ThresholdSelection": {
      "additionalProperties": false,
      "properties": {
        "objective_value": {
          "title": "Objective Value",
          "type": "number"
        },
        "threshold": {
          "maximum": 1,
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        },
        "trials": {
          "items": {
            "$ref": "#/$defs/ThresholdTrial"
          },
          "title": "Trials",
          "type": "array"
        }
      },
      "required": [
        "threshold",
        "objective_value",
        "trials"
      ],
      "title": "ThresholdSelection",
      "type": "object"
    },
